# Copy to .env for local development (.env is git-ignored).
ADMIN_PASSWORD=changeme123
SECRET_KEY=dev-only-not-secret-0123456789
PUBLIC_BASE_URL=http://localhost:8000

# Option A: local SMTP sink, prints every email to the terminal (see README):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=santa@example.com
SMTP_PASSWORD=unused

# Option B: real Yahoo Mail (needs an app password, see README):
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USERNAME=you@yahoo.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM_NAME=Secret Santa
